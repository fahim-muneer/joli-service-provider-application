# Copy to .env (and restart `npm run dev`). Never put secrets in VITE_ variables: they are public.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# Where "Become a Provider" / "Register as a partner" send people (the separate provider app). Empty = the in-app page.
VITE_PROVIDER_APP_URL=
# Optional text shown in the grey announcement strip under the header.
VITE_ANNOUNCEMENT=
